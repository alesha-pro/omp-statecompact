{
  "name": "omp-statecompact",
  "version": "0.4.0",
  "description": "Canonical current-state compaction for Oh My Pi coding sessions",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Alexey",
    "url": "https://github.com/alesha-pro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alesha-pro/omp-statecompact.git"
  },
  "homepage": "https://github.com/alesha-pro/omp-statecompact#readme",
  "bugs": {
    "url": "https://github.com/alesha-pro/omp-statecompact/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "llm",
    "coding-agent",
    "context-compaction",
    "agent-memory"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test --path-ignore-patterns='benchmark/**'",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "package:check": "bun pm pack --dry-run",
    "package:verify": "bun scripts/verify-package.ts",
    "release:check": "bun run check && bun run package:check && bun run package:verify"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "17.2.11",
    "@oh-my-pi/pi-ai": "17.2.11"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.2.11",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
